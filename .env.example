# ─── Client (Vite) ───────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in. Every value is optional: the site builds and
# runs with blanks, and contact surfaces degrade to "not published yet".

VITE_ORG_EMAIL=
VITE_ORG_PHONE=
VITE_ORG_PHONE_2=
VITE_ORG_ADDRESS=
VITE_ORG_MAP_URL=
VITE_ORG_REGISTRATION=
VITE_ORG_FACEBOOK=
VITE_ORG_X=
VITE_ORG_LINKEDIN=
VITE_ORG_INSTAGRAM=

# Where `npm run dev:web` proxies /api requests during development. Only used by
# the Vite dev server; the production build ignores it.
VITE_API_PROXY_TARGET=http://localhost:4000

# Base URL the built client prepends to /api paths. LEAVE EMPTY when the app
# serves its own API from the same origin, which is the normal deployment —
# the dashboard's session cookie is same-origin, and pointing this at a
# different origin breaks sign-in. Set it only if you host the frontend
# statically and run the API on a separate domain.
# VITE_API_BASE_URL=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0

# "production" enables rate limiting and the Secure flag on the session cookie.
# Leave it as "development" locally, or the Secure cookie will be dropped over
# plain http and sign-in will silently fail.
NODE_ENV=development

# Set when running behind a reverse proxy (nginx, Fly, Render, Cloudflare...)
# to the number of proxy hops so rate limiting sees real client IPs.
TRUST_PROXY_HOPS=1

# Where the SQLite database and uploaded images are written.
# Defaults to ./data, which is git-ignored. Point this at a persistent volume in
# production, otherwise a redeploy discards the dashboard's content.
DATA_DIR=

# Overrides the database file path. Rarely needed — set it only to keep the .db
# somewhere other than DATA_DIR (for example on a separate, larger volume).
# DATABASE_FILE=

MAX_ENQUIRY_RECORDS=10000

# Set to "false" to run API-only without serving ./dist
SERVE_STATIC=true

# ─── Admin dashboard ──────────────────────────────────────────────────────────
# The dashboard lives at /admin. It is disabled entirely while ADMIN_PASSWORD is
# empty, and every write endpoint refuses requests in that state, so a
# forgotten variable fails closed rather than leaving content unprotected.

# Required to enable the dashboard. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Signs the session cookie. If unset, ADMIN_PASSWORD is reused as the HMAC key
# and a warning is logged — that means a stolen cookie and a stolen password are
# the same secret, so set a separate value before deploying.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# How long a dashboard session lasts, in milliseconds. Default 8 hours.
ADMIN_SESSION_TTL_MS=28800000

# ─── Upload ceilings ─────────────────────────────────────────────────────────
# Three distinct limits, not one. They are separate so that a document cannot
# use the video allowance to push padding through, and a video cannot be held
# to the image limit.

# Largest accepted image upload in bytes. Default 8 MiB.
MAX_UPLOAD_BYTES=8388608

# Largest accepted video in bytes. Default 100 MiB.
MAX_VIDEO_BYTES=104857600

# Largest accepted PDF in bytes. Default 25 MiB.
MAX_DOCUMENT_BYTES=26214400

# ─── Email configuration (Nodemailer) ───────────────────────────────────────
# SMTP settings for sending enquiry emails. If not set, emails will only be stored
# in the database and not sent.

# SMTP host (e.g., smtp.gmail.com, smtp.office365.com)
SMTP_HOST=
# SMTP port (e.g., 587 for TLS, 465 for SSL)
SMTP_PORT=587
# SMTP username (usually your email address)
SMTP_USER=
# SMTP password or app-specific password
SMTP_PASSWORD=
# Email address that will receive enquiry emails
EMAIL_TO=
# Email address that will send the emails (usually same as SMTP_USER)
EMAIL_FROM=
# Whether to use TLS (true for port 587, false for port 465)
SMTP_SECURE=true
