node_modules
dist
data
*.tsbuildinfo
.env
.env.local
.env.*.local

# Backup copies of the real environment. `.env` itself is ignored, but a copy
# made with any other suffix — .env.bak, .env.old, .env.production — is not
# covered by the rules above and would be picked up by `git add .`, leaking
# ADMIN_PASSWORD and the session secret into the repository history. Real
# environment files should never be committed in any form; `.env.example` is
# the committed template.
.env.*
!.env.example

# Backup bundles from `npm run backup`. These are copies of the live database and
# every uploaded document — committing one would publish unpublished content and
# the policy PDFs, and would replace the real content on a fresh clone.
backups

# SQLite files, in case DATA_DIR is ever pointed somewhere inside the repo. The
# -wal and -shm siblings are listed too: a bare website.db is a partial backup,
# because recent commits still live in the -wal file.
*.db
*.db-wal
*.db-shm

*.log
npm-debug.log*
.DS_Store
.vite
coverage
